# Vorlage für .env: `make init` kopiert sie und ersetzt die drei Secrets durch Zufallswerte.

# --- Datenbank und Secrets (alle Stacks) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password-here
JWT_SECRET=your-256-bit-secret-replace-this-in-production
# Token, mit dem sich das Druck-Relay am Backend anmeldet.
RELAY_AUTH_TOKEN=your-relay-auth-token-replace-this-in-production

# --- Selbst gehosteter Betrieb (docker-compose.prod.yml) ---
# Öffentliche Domain und Kontaktadresse für Let's Encrypt; Caddy holt und erneuert das Zertifikat.
# Jeder Befehl dieses Stacks braucht JOTTI_DOMAIN. Siehe docs/leitfaden/self-hosting.md.
JOTTI_DOMAIN=
LETSENCRYPT_EMAIL=
# Release-Tag (vX.Y.Z) von https://github.com/nicograef/jotti/releases.
# Pflicht für `make prod-init` und `make prod-update`.
JOTTI_VERSION=
# Optional: 1 leitet www.<domain> auf <domain> um; braucht einen DNS-Eintrag für www.
JOTTI_WWW_REDIRECT=
# Backups (`make prod-backup`, `make prod-restore`): Zielverzeichnis und Anzahl behaltener Dumps.
# BACKUP_KEEP<=0 behält alle. Beide optional, die Werte hier sind die Standardwerte.
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Optional: URL, die nach jedem erfolgreichen Backup aufgerufen wird (z. B. ein healthchecks.io-Ping).
# Leer schaltet den Aufruf ab. Ein fehlgeschlagener Aufruf lässt das Backup nicht scheitern.
BACKUP_PING_URL=

# --- Reverse Proxy (lokaler und selbst gehosteter Betrieb) ---
# 1 holt Zertifikate von der Staging-CA von Let's Encrypt; nur zum Testen, Browser vertrauen ihnen nicht.
# PROXY_LE_STAGING=
# acme-dns-API für das LAN-Zertifikat des lokalen Betriebs.
# ACMEDNS_BASE_URL=https://auth.jotti.rocks

# --- jotti.rocks (docker-compose.rocks.yml) ---
# Öffentliche IPv4 dieses Servers für DNS-Resolver und acme-dns; im selbst gehosteten Betrieb leer lassen.
# Siehe docs/jotti-rocks-infra.md.
VPS_PUBLIC_IP=
