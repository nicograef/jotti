# PostgreSQL Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password-here

# JWT Authentication
# IMPORTANT: `make init` generates a secure random secret automatically.
JWT_SECRET=your-256-bit-secret-replace-this-in-production

# Relay Authentication (for print relay -> backend)
# IMPORTANT: `make init` generates a secure random token automatically.
RELAY_AUTH_TOKEN=your-relay-auth-token-replace-this-in-production

# --- Self-hosted production (docker-compose.prod.yml / Weg B) ---
# Your public domain and the contact email for the Let's Encrypt account. Caddy
# obtains and renews the certificate automatically; both are required for
# `make prod-init`. See docs/betrieb/leitfaden-hosting.md.
JOTTI_DOMAIN=
LETSENCRYPT_EMAIL=
# Pinned image version (a release tag like v0.1.0, or `latest`).
JOTTI_VERSION=latest
# Optional: redirect www.<domain> to <domain> (set to 1; needs www DNS here).
JOTTI_WWW_REDIRECT=

# Public IPv4 of this server. Only required for the jotti.rocks / local-TLS stack
# (DNS resolver + acme-dns); leave empty for plain self-hosted production.
# See docs/betrieb/leitfaden-rocks-dns.md.
VPS_PUBLIC_IP=
