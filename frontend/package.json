    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
