---
import { Image } from 'astro:assets'

import Landing from '../layouts/Landing.astro'
import bon from '../assets/jotti-bon.webp'
import jottiSymbol from '../assets/jotti-symbol.png'
import tischeUebersicht from '../assets/screenshots/service-tische-uebersicht.png'
import tischBestellen from '../assets/screenshots/tisch-bestellen.png'
import tischZahlung from '../assets/screenshots/tisch-zahlung.png'
import tischStornierung from '../assets/screenshots/tisch-stornierung.png'
import kasseGeldtransit from '../assets/screenshots/kasse-geldtransit.png'
import produkteVerwalten from '../assets/screenshots/produkte-verwalten.png'
import benutzerVerwalten from '../assets/screenshots/benutzer-verwalten.png'
import auswertungHistorisch from '../assets/screenshots/auswertung-historisch.png'
import direktverkauf from '../assets/screenshots/direktverkauf.png'
import { githubUrl, leitfadenUrl } from '../lib/links'

// Reihenfolge der Showcase-Sektion „Einblicke" (CSS-Scroll-Snap-Carousel).
// Service- und Admin-Ansichten gemischt; Alt-Texte stammen aus
// screenshots/README.md.
const carouselSlides = [
  {
    src: tischeUebersicht,
    titel: 'Meine Tische',
    alt: 'jotti Service-Startseite „Meine Tische" mit persönlichen Kennzahlen und den offenen Tisch-Karten samt Saldo und „offen"-Badge.',
  },
  {
    src: tischBestellen,
    titel: 'Bestellen',
    alt: 'Bestell-Ansicht von Tisch 4: aufgeklappte Kategorie mit Mengen-Steppern und grüner Aktionsleiste mit 3 Positionen für 14,50 €.',
  },
  {
    src: tischZahlung,
    titel: 'Kassieren',
    alt: 'Zahlung-Drawer für Tisch 4 mit Eingabe für Trinkgeld und Erhalten sowie automatisch berechnetem Rückgeld und Trinkgeld.',
  },
  {
    src: tischStornierung,
    titel: 'Stornieren',
    alt: 'Storno-Drawer zum positionsweisen Stornieren mit gewähltem Artikel und Pflicht-Kommentar vor „Stornierung erteilen".',
  },
  {
    src: kasseGeldtransit,
    titel: 'Kassensitzung',
    alt: 'Offene Kassensitzung mit dem Formular „Geldtransit buchen" zum Erfassen von Einlage oder Entnahme.',
  },
  {
    src: produkteVerwalten,
    titel: 'Produkte verwalten',
    alt: 'Produktverwaltung mit aufklappbaren Produkt-Karten, aktiven Varianten samt Preisen und dem Button „+ Neues Produkt".',
  },
  {
    src: auswertungHistorisch,
    titel: 'Auswertung',
    alt: 'Historische Auswertung einer Kassensitzung mit vier Kennzahl-Karten, DSFinV-K-Export-Button und der Tabelle „Umsatz nach Steuersatz".',
  },
  {
    src: direktverkauf,
    titel: 'Direktverkauf',
    alt: 'Direktverkauf im Reiter „Verkaufen" mit Verkaufszusammenfassung, Kommentarfeld und Button „Verkauf abschließen".',
  },
]

const title = 'jotti: Das kostenlose Kassensystem für Vereinsfeste'
const description =
  'jotti ist ein kostenloses Mobile-Kassensystem (mPOS) für Vereine und gemeinnützige Organisationen. Mit BSI-zertifizierter Cloud-TSE, Belegausgabe nach § 146a AO und DSFinV-K-Export. Self-hosted, Mobile-first, kein Cloud-Abo. Quellcode einsehbar (Source-Available).'
---

<Landing title={title} description={description}>
  {/* ============ HERO ============ */}
  <section class="hero-gradient">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-12 pb-10 text-center md:pt-20 md:pb-16 lg:grid-cols-2 lg:text-left"
    >
      <div class="lg:max-w-[34rem]">
        <p class="eyebrow mb-4">
          Mobile Kasse für das Ehrenamt
          <span class="badge-wip normal-case">Beta</span>
        </p>
        <h1
          class="mb-5 text-3xl font-bold tracking-tight text-balance sm:text-5xl"
        >
          Das kostenlose Kassensystem
          <span class="text-brand">für euer Vereinsfest.</span>
        </h1>
        <p class="mb-6 text-lg text-muted">
          Bestellen, ausgeben, kassieren: direkt auf dem Smartphone, ohne
          eigene Hardware. Gemacht für Vereine und gemeinnützige
          Organisationen.
        </p>
        <ul
          class="mb-8 flex flex-wrap justify-center gap-x-6 gap-y-3 lg:justify-start"
        >
          <li class="flex items-center gap-2 font-bold">
            <svg
              class="text-brand"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"
              ></path>
              <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
            </svg>
            Kostenlos
          </li>
          <li class="flex items-center gap-2 font-bold">
            <svg
              class="text-brand"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect>
              <rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect>
              <line x1="6" x2="6.01" y1="6" y2="6"></line>
              <line x1="6" x2="6.01" y1="18" y2="18"></line>
            </svg>
            Läuft auf eurem Server
          </li>
          <li class="flex items-center gap-2 font-bold">
            <svg
              class="text-brand"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
              ></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            TSE-Anbindung
          </li>
        </ul>
        <div
          class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:justify-center lg:justify-start"
        >
          <a href={leitfadenUrl} class="btn btn-primary"
            >Leitfaden für Vereine lesen</a
          >
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
              ></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            Auf GitHub ansehen
          </a>
        </div>
      </div>
      <div class="order-first flex items-center justify-center lg:order-none">
        <Image
          src={tischeUebersicht}
          alt="jotti Service-Ansicht auf einem Smartphone: Tischübersicht mit offenen Saldi und „offen“-Badges"
          class="phone-shot w-full max-w-[200px] lg:max-w-[300px]"
          widths={[200, 300, 400, 600]}
          sizes="(min-width: 1024px) 300px, 200px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  {/* ============ FÜR WEN ============ */}
  <section class="py-16 sm:py-24" id="fuer-wen">
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-3 text-center">Zielgruppe</p>
      <h2
        class="mb-3 text-center text-2xl font-bold tracking-tight sm:text-4xl"
      >
        Für wen ist jotti gedacht?
      </h2>
      <p
        class="mx-auto mb-12 max-w-160 text-center text-[1.0625rem] text-muted"
      >
        jotti ist für gemeinnützige Organisationen, die Feste mit Essen und
        Getränken veranstalten. Auf die Rechtsform kommt es nicht an.
      </p>
      <div class="grid gap-x-10 gap-y-7 md:grid-cols-2">
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <h3 class="mb-1.5 text-lg font-bold">Vereine (e.V.)</h3>
          <p class="card-text">
            Sport-, Musik-, Schützen-, Karnevals- und Fördervereine: jeder
            eingetragene Verein, der Feste veranstaltet.
          </p>
        </div>
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
              <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
              <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path>
              <path d="M10 6h4"></path>
              <path d="M10 10h4"></path>
              <path d="M10 14h4"></path>
              <path d="M10 18h4"></path>
            </svg>
          </span>
          <h3 class="mb-1.5 text-lg font-bold">Gemeinnützige Organisationen</h3>
          <p class="card-text">
            gGmbH, gUG, Stiftungen, kirchliche Träger, NGOs: alle, die als
            gemeinnützig anerkannt sind.
          </p>
        </div>
      </div>

      <h3 class="mt-12 mb-5 text-center text-lg font-bold">
        Typische Veranstaltungen
      </h3>
      <div class="flex flex-wrap justify-center gap-2.5">
        <span class="tag">Vereinsfeste</span>
        <span class="tag">Sommerfeste</span>
        <span class="tag">Weihnachtsmärkte</span>
        <span class="tag">Maihocks</span>
        <span class="tag">Straßenfeste</span>
        <span class="tag">Konzerte</span>
        <span class="tag">Sportevents</span>
        <span class="tag">Fasching</span>
        <span class="tag">Jubiläen</span>
        <span class="tag">Kulturveranstaltungen</span>
      </div>
    </div>
  </section>

  {/* ============ NUTZEN (Versprechen + Warum) ============ */}
  <section class="bg-surface-alt py-16 sm:py-24" id="versprechen">
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-3 text-center">Der Nutzen</p>
      <h2
        class="mb-3 text-center text-2xl font-bold tracking-tight sm:text-4xl"
      >
        Kostenlos heißt wirklich kostenlos.
      </h2>
      <p
        class="mx-auto mb-12 max-w-160 text-center text-[1.0625rem] text-muted"
      >
        Kein Haken, kein Abo, keine Premium-Stufe. jotti bleibt für
        gemeinnützige Organisationen dauerhaft kostenlos.
      </p>
      <div class="grid gap-x-10 gap-y-7 md:grid-cols-2">
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"
              ></path>
            </svg>
          </span>
          <h3 class="mb-1.5 text-lg font-bold">Voller Funktionsumfang</h3>
          <p class="card-text">
            Alle Funktionen sind frei, auch die Bausteine fürs Finanzamt: TSE
            (die vorgeschriebene technische Sicherheitseinrichtung), Belege und
            Datenexport. Keine Limits bei Tischen, Produkten oder Benutzern.
          </p>
        </div>
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"
              ></path>
              <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
              <path
                d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"
              ></path>
              <path d="m2 2 20 20"></path>
            </svg>
          </span>
          <h3 class="mb-1.5 text-lg font-bold">Keine Werbung, kein Tracking</h3>
          <p class="card-text">
            Keine Anzeigen, keine Datensammelei. Eure Daten liegen auf eurem
            eigenen Server und bleiben bei euch.
          </p>
        </div>
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m16 18 6-6-6-6"></path>
              <path d="m8 6-6 6 6 6"></path>
            </svg>
          </span>
          <h3 class="mb-1.5 text-lg font-bold">Quellcode einsehbar</h3>
          <p class="card-text">
            Jeder kann im Quellcode nachlesen, was die Software tut und wie sie
            mit euren Daten umgeht.
          </p>
        </div>
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 12h-5"></path>
              <path d="M15 8h-5"></path>
              <path d="M19 17V5a2 2 0 0 0-2-2H4"></path>
              <path
                d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"
              ></path>
            </svg>
          </span>
          <h3 class="mb-1.5 text-lg font-bold">Keine Vertragslaufzeit</h3>
          <p class="card-text">
            Keine Mindestlaufzeit, keine Kündigungsfrist. Ihr nutzt jotti so
            lange, wie es euch hilft.
          </p>
        </div>
      </div>

      <h3
        class="mt-14 mb-3 text-center text-xl font-bold tracking-tight sm:text-2xl"
      >
        Warum jotti?
      </h3>
      <p
        class="mx-auto mb-12 max-w-160 text-center text-[1.0625rem] text-muted"
      >
        Die meisten Vereine rechnen ihre Feste mit Stift und Papier, Excel
        oder einer Profi-Kasse ab. Alle drei haben ihre Grenzen.
      </p>
      <div class="grid gap-x-10 gap-y-7 lg:grid-cols-3">
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 20h9"></path>
              <path
                d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"
              ></path>
            </svg>
          </span>
          <h4 class="mb-1.5 text-lg font-bold">Stift &amp; Papier</h4>
          <p class="card-text">
            Verlorene Bonblöcke, keine Übersicht, stundenlange Abrechnung. Und
            die gesetzlichen Kassenregeln erfüllt ihr damit nicht.
          </p>
        </div>
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <path d="M3 9h18"></path>
              <path d="M3 15h18"></path>
              <path d="M12 3v18"></path>
            </svg>
          </span>
          <h4 class="mb-1.5 text-lg font-bold">Excel-Tabelle</h4>
          <p class="card-text">
            Einer tippt, alle anderen warten. Keine Tische, keine gemeinsame
            Übersicht, keine TSE.
          </p>
        </div>
        <div class="card">
          <span class="icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="14" x="2" y="5" rx="2"></rect>
              <line x1="2" x2="22" y1="10" y2="10"></line>
            </svg>
          </span>
          <h4 class="mb-1.5 text-lg font-bold">Profi-Kasse</h4>
          <p class="card-text">
            Kann alles, ist aber für den täglichen Gastrobetrieb gemacht und
            kostet 30 bis 100 € im Monat plus Hardware. Für zwei, drei Feste im
            Jahr lohnt sich das selten.
          </p>
        </div>
      </div>

      <h4 class="mt-12 mb-5 text-center text-lg font-bold">
        jotti löst genau diese Probleme.
      </h4>
      <div class="-mx-6 overflow-x-auto px-6">
        <table
          class="w-full overflow-hidden rounded-lg border border-card-border bg-card text-sm"
        >
          <thead>
            <tr
              class="bg-surface-alt text-xs tracking-wider text-muted uppercase"
            >
              <th class="p-3 text-left font-bold"></th>
              <th class="p-3 text-left font-bold text-brand" scope="col"
                >jotti</th
              >
              <th class="p-3 text-left font-bold" scope="col"
                >Stift &amp; Papier</th
              >
              <th class="p-3 text-left font-bold" scope="col"
                >Profi-Kasse</th
              >
            </tr>
          </thead>
          <tbody
            class="[&_td]:p-3 [&_td]:text-muted [&_th]:p-3 [&_tr]:border-t [&_tr]:border-card-border"
          >
            <tr>
              <th scope="row" class="text-left font-semibold">Kosten</th>
              <td class="bg-brand-tint font-bold text-foreground">Kostenlos</td>
              <td>~0 €</td>
              <td>30–100 €/Monat + Hardware</td>
            </tr>
            <tr>
              <th scope="row" class="text-left font-semibold">Hardware</th>
              <td class="bg-brand-tint font-bold text-foreground"
                >Eigenes Smartphone</td
              >
              <td>Stifte, Bonblöcke</td>
              <td>Terminal, iPad, Drucker</td>
            </tr>
            <tr>
              <th scope="row" class="text-left font-semibold"
                >Gesetzliche Vorgaben</th
              >
              <td class="bg-brand-tint font-bold text-foreground">
                TSE, Beleg &amp; Export integriert
              </td>
              <td>✗</td>
              <td>✓</td>
            </tr>
            <tr>
              <th scope="row" class="text-left font-semibold">Abrechnung</th>
              <td class="bg-brand-tint font-bold text-foreground"
                >Automatisch, mit Export</td
              >
              <td>Stundenlang manuell</td>
              <td>Automatisch</td>
            </tr>
            <tr>
              <th scope="row" class="text-left font-semibold">Einrichtung</th>
              <td class="bg-brand-tint font-bold text-foreground">Minuten</td>
              <td>Sofort</td>
              <td>Tage bis Wochen</td>
            </tr>
            <tr>
              <th scope="row" class="text-left font-semibold">Eure Daten</th>
              <td class="bg-brand-tint font-bold text-foreground"
                >Eigener Server</td
              >
              <td>Zettelwirtschaft</td>
              <td>Beim Anbieter</td>
            </tr>
            <tr>
              <th scope="row" class="text-left font-semibold"
                >Vertragslaufzeit</th
              >
              <td class="bg-brand-tint font-bold text-foreground">Keine</td>
              <td>Keine</td>
              <td>12–24 Monate</td>
            </tr>
