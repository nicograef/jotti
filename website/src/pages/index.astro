---
import { Image } from 'astro:assets'

import Landing from '../layouts/Landing.astro'
import Hero from '../components/Hero.astro'
import Features from '../components/Features.astro'
import Demo from '../components/Demo.astro'
import Ablauf from '../components/Ablauf.astro'
import FuerWen from '../components/FuerWen.astro'
import Preis from '../components/Preis.astro'
import Sicherheit from '../components/Sicherheit.astro'
import Faq from '../components/Faq.astro'
import Download from '../components/Download.astro'
import tischeUebersicht from '../assets/screenshots/service-tische-uebersicht.png'
import tischBestellen from '../assets/screenshots/tisch-bestellen.png'
import tischZahlung from '../assets/screenshots/tisch-zahlung.png'
import tischStornierung from '../assets/screenshots/tisch-stornierung.png'
import kasseGeldtransit from '../assets/screenshots/kasse-geldtransit.png'
import produkteVerwalten from '../assets/screenshots/produkte-verwalten.png'
import auswertungHistorisch from '../assets/screenshots/auswertung-historisch.png'
import direktverkauf from '../assets/screenshots/direktverkauf.png'

// Reihenfolge der Showcase-Sektion „Einblicke" (CSS-Scroll-Snap-Carousel).
// Service- und Admin-Ansichten gemischt; Alt-Texte stammen aus
// screenshots/README.md.
const carouselSlides = [
  {
    src: tischeUebersicht,
    titel: 'Meine Tische',
    alt: 'jotti Service-Startseite „Meine Tische" mit persönlichen Kennzahlen und den offenen Tisch-Karten samt Saldo und „offen"-Badge.',
  },
  {
    src: tischBestellen,
    titel: 'Bestellen',
    alt: 'Bestell-Ansicht von Tisch 4: aufgeklappte Kategorie mit Mengen-Steppern und grüner Aktionsleiste mit 3 Positionen für 14,50 €.',
  },
  {
    src: tischZahlung,
    titel: 'Kassieren',
    alt: 'Zahlung-Drawer für Tisch 4 mit Eingabe für Trinkgeld und Erhalten sowie automatisch berechnetem Rückgeld und Trinkgeld.',
  },
  {
    src: tischStornierung,
    titel: 'Stornieren',
    alt: 'Storno-Drawer zum positionsweisen Stornieren mit gewähltem Artikel und Pflicht-Kommentar vor „Stornierung erteilen".',
  },
  {
    src: kasseGeldtransit,
    titel: 'Kassensitzung',
    alt: 'Offene Kassensitzung mit dem Formular „Geldtransit buchen" zum Erfassen von Einlage oder Entnahme.',
  },
  {
    src: produkteVerwalten,
    titel: 'Produkte verwalten',
    alt: 'Produktverwaltung mit aufklappbaren Produkt-Karten, aktiven Varianten samt Preisen und dem Button „+ Neues Produkt".',
  },
  {
    src: auswertungHistorisch,
    titel: 'Auswertung',
    alt: 'Historische Auswertung einer Kassensitzung mit vier Kennzahl-Karten, DSFinV-K-Export-Button und der Tabelle „Umsatz nach Steuersatz".',
  },
  {
    src: direktverkauf,
    titel: 'Direktverkauf',
    alt: 'Direktverkauf im Reiter „Verkaufen" mit Verkaufszusammenfassung, Kommentarfeld und Button „Verkauf abschließen".',
  },
]

const title = 'jotti: Das kostenlose Kassensystem für Vereinsfeste'
const description =
  'jotti ist ein kostenloses Mobile-Kassensystem (mPOS) für Vereine und gemeinnützige Organisationen. Mit BSI-zertifizierter Cloud-TSE, Belegausgabe nach § 146a AO und DSFinV-K-Export. Self-hosted, Mobile-first, kein Cloud-Abo. Quellcode einsehbar (Source-Available).'
---

<Landing title={title} description={description}>
  {/* ============ HERO ============ */}
  <Hero />

  {/* ============ FEATURES ============ */}
  <Features />

  {/* ============ LIVE-DEMO ============ */}
  <Demo />

  {/* ============ ABLAUF ============ */}
  <Ablauf />

  {/* ============ FÜR WEN ============ */}
  <FuerWen />

  {/* ============ EINBLICKE (Screenshot-Carousel) ============ */}
  <section
    class="bg-surface-alt py-16 sm:py-24"
    id="einblicke"
    aria-roledescription="Bildergalerie"
    aria-label="Einblicke in jotti"
    data-carousel
  >
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-3 text-center">Einblicke</p>
      <h2
        class="mb-3 text-center text-2xl font-bold tracking-tight sm:text-4xl"
      >
        So sieht jotti aus.
      </h2>
      <p
        class="mx-auto mb-12 max-w-160 text-center text-[1.0625rem] text-muted"
      >
        Echte Ansichten aus der Demo „Sommerfest 26". Wischen oder mit den
        Pfeilen blättern.
      </p>
    </div>

    <div class="carousel">
      <ul class="carousel-track" data-carousel-track>
        {
          carouselSlides.map((slide) => (
            <li class="carousel-slide">
              <figure class="m-0">
                <Image
                  src={slide.src}
                  alt={slide.alt}
                  class="phone-shot w-full"
                  widths={[240, 320, 480]}
                  sizes="(min-width: 640px) 16rem, 70vw"
                  loading="lazy"
                />
                <figcaption class="mt-4 text-center text-sm font-semibold text-brand">
                  {slide.titel}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <div class="carousel-controls">
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-prev
          aria-label="Vorheriges Bild"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>
        <ul class="carousel-dots" data-carousel-dots>
          {
            carouselSlides.map((slide, index) => (
              <li>
                <button
                  type="button"
                  class="carousel-dot"
                  data-carousel-dot
                  data-index={index}
                  aria-label={`Zu Bild ${index + 1}: ${slide.titel}`}
                  aria-current={index === 0 ? 'true' : 'false'}
                />
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-next
          aria-label="Nächstes Bild"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  {/* ============ PREIS ============ */}
  <Preis />

  {/* ============ SICHERHEIT & COMPLIANCE ============ */}
  <Sicherheit />

  {/* ============ FAQ ============ */}
  <Faq />

  {/* ============ DOWNLOAD ============ */}
  <Download />

  {/*
    Externe Datei aus public/ statt eines gebuendelten <script>: Die Produktiv-CSP
    (`script-src 'self'`) blockiert Inline-Skripte (siehe theme-init.js).
    is:inline laesst Astro das Tag unveraendert. Das Carousel ist ohne JS voll
    bedienbar; das Skript ergaenzt nur Pfeile und Punkt-Indikatoren.
  */}
  <script is:inline type="module" src="/carousel.js"></script>
</Landing>
