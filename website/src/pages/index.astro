  {/* ============ EINBLICKE (Screenshot-Carousel) ============ */}
  <section
    class="bg-surface-alt py-16 sm:py-24"
    id="einblicke"
    aria-roledescription="Bildergalerie"
    aria-label="Einblicke in jotti"
    data-carousel
  >
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-3 text-center">Einblicke</p>
      <h2
        class="mb-3 text-center text-2xl font-bold tracking-tight sm:text-4xl"
      >
        So sieht jotti aus.
      </h2>
      <p
        class="mx-auto mb-12 max-w-160 text-center text-[1.0625rem] text-muted"
      >
        Echte Ansichten aus der Demo „Sommerfest 26" — vom Bestellen am Tisch
        bis zur Auswertung. Wischen oder mit den Pfeilen blättern.
      </p>
    </div>

    <div class="carousel">
      <ul class="carousel-track" data-carousel-track>
        {
          carouselSlides.map((slide) => (
            <li class="carousel-slide">
              <figure class="m-0">
                <Image
                  src={slide.src}
                  alt={slide.alt}
                  class="phone-shot w-full"
                  widths={[240, 320, 480]}
                  sizes="(min-width: 640px) 16rem, 70vw"
                  loading="lazy"
                />
                <figcaption class="mt-4 text-center text-sm font-semibold text-brand">
                  {slide.titel}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <div class="carousel-controls">
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-prev
          aria-label="Vorheriges Bild"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>
        <ul class="carousel-dots" data-carousel-dots>
          {
            carouselSlides.map((slide, index) => (
              <li>
                <button
                  type="button"
                  class="carousel-dot"
                  data-carousel-dot
                  data-index={index}
                  aria-label={`Zu Bild ${index + 1}: ${slide.titel}`}
                  aria-current={index === 0 ? 'true' : 'false'}
                />
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          class="carousel-arrow"
          data-carousel-next
          aria-label="Nächstes Bild"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

