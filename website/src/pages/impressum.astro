---
import Landing from '../layouts/Landing.astro'
import { betreiberEmail, githubUrl } from '../lib/links'

// Impressum (Anbieterkennzeichnung, § 5 DDG). Statische Seite auf Basis des
// Landing-Layouts (Header/Footer, eigene Meta über die Layout-Props). Neben der
// E-Mail-Adresse dient das Anfrage-Formular (/fuer-vereine) als zweiter Weg zur
// schnellen elektronischen Kontaktaufnahme (EuGH, C-298/07: eine Telefonnummer
// ist nicht erforderlich, solange ein weiterer effizienter Kanal besteht). Eine
// Angabe nach § 18 Abs. 2 MStV entfällt bewusst: die Website ist ein Produkt-
// und Dokumentationsangebot, kein journalistisch-redaktionell gestaltetes.

const title = 'Impressum – jotti'
const description =
  'Impressum und Anbieterkennzeichnung für jotti, das kostenlose Kassensystem für Vereinsfeste.'
---

<Landing title={title} description={description}>
  <article class="mx-auto max-w-[760px] px-6 py-16 sm:py-24">
    <h1
      class="font-brand text-[length:var(--fs-h2)] leading-[1.06] font-bold tracking-[-0.025em]"
    >
      Impressum
    </h1>
    <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted">
      Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG).
    </p>

    <h2 class="font-brand mt-10 text-[22px] font-bold tracking-[-0.02em]">
      Diensteanbieter
    </h2>
    <p class="mt-3 text-[0.9375rem] leading-relaxed">
      Nico Gräf<br />
      Tränkestraße 32<br />
      79114 Freiburg im Breisgau<br />
      Deutschland
    </p>

    <h2 class="font-brand mt-10 text-[22px] font-bold tracking-[-0.02em]">
      Kontakt
    </h2>
    <p class="mt-3 text-[0.9375rem] leading-relaxed">
      E-Mail: <a
        href={`mailto:${betreiberEmail}`}
        class="font-semibold text-brand hover:underline">{betreiberEmail}</a
      >
    </p>
    <p class="mt-3 text-[0.9375rem] leading-relaxed">
      Für Anfragen zur Nutzungsvereinbarung steht außerdem das Formular auf
      <a href="/fuer-vereine" class="font-semibold text-brand hover:underline"
        >jotti.rocks/fuer-vereine</a
      > bereit; es öffnet einen vorbefüllten E-Mail-Entwurf an die genannte Adresse.
    </p>

    <h2 class="font-brand mt-10 text-[22px] font-bold tracking-[-0.02em]">
      Urheberrecht und Lizenz
    </h2>
    <p class="mt-3 text-[0.9375rem] leading-relaxed">
      Die Inhalte dieser Website — Texte, Gestaltung und Bildschirmfotos — sind
      urheberrechtlich geschützt (© 2025–2026 Nico Gräf). Die Software jotti
      ist source-available; ihre Nutzung regeln die
      <a
        href={`${githubUrl}/blob/main/TERMS.md`}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-brand hover:underline">Nutzungsbedingungen</a
      > und die
      <a
        href={`${githubUrl}/blob/main/LICENSE`}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-brand hover:underline">Lizenz</a
      >.
    </p>
  </article>
</Landing>
