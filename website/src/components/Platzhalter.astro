---
// Deutlich markierter Platzhalter-Block für die Rechtsseiten (Impressum,
// Datenschutz). Die finalen Texte setzt der Betreiber vor der Abnahme ein
// (Plan Phase 7/10). Visuell abgesetzt: gestrichelter Rahmen, getönter Grund,
// vorangestelltes „PLATZHALTER"-Label mit Betreff, damit im gebauten Artefakt
// unübersehbar bleibt, was noch zu ersetzen ist.

interface Props {
  betreff: string
}

const { betreff } = Astro.props
---

<div
  class="my-4 rounded-lg border-2 border-dashed border-[var(--sp-orange)] bg-[color-mix(in_srgb,var(--sp-orange)_8%,transparent)] p-4 text-[0.9375rem] leading-relaxed text-foreground"
>
  <p
    class="mb-1.5 text-[0.75rem] font-bold tracking-[0.08em] text-[var(--sp-orange)] uppercase"
  >
    Platzhalter: {betreff}
  </p>
  <slot />
</div>
