---
/*
  Override für Starlights ThemeProvider: dessen Inline-Theme-Init blockt die
  Produktiv-CSP (`script-src 'self'`, kein `unsafe-inline`). Lädt stattdessen
  /theme-init.js — gleicher Speicher-Key, gleiche Semantik, gleiches
  `window.StarlightThemeProvider`-Global, nur CSP-konform und ohne FOUC.
*/
import { Icon } from '@astrojs/starlight/components'
---

<script is:inline src="/theme-init.js"></script>

<template id="theme-icons">
  <Icon name="sun" class="light" />
  <Icon name="moon" class="dark" />
  <Icon name="laptop" class="auto" />
</template>
