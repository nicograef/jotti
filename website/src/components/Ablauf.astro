---
import { Settings2, Smartphone, Euro, FileCheck } from '@lucide/astro'

// Ablauf-Sektion der Landing (Handoff-Prototyp docs/prds/design_handoff_jotti_website, #ablauf).
// Statische Astro-Sektion ohne client:-Direktive. Vier nummerierte Schritte vom
// Einrichten bis zum Z-Bon, jeder mit eigenem Spektral-Akzent; im Desktop-Layout
// verbindet eine spektrale Linie die Schritt-Icons. Icons über @lucide/astro
// (build-time SVG, kein Client-JS) — der Plan verlangt die offiziellen
// Lucide-Pakete statt eines Sprite-Nachbaus.
//
// Scroll-Reveal (.reveal) ist Progressive Enhancement; unter
// prefers-reduced-motion bleibt alles statisch sichtbar (siehe landing.css).

const schritte = [
  {
    Icon: Settings2,
    accent: 'var(--sp-red)',
    label: 'Schritt 1',
    titel: 'Einrichten',
    text: 'Produkte mit Varianten & Steuersätzen, Tische und Helfer:innen im Admin-Bereich anlegen.',
  },
  {
    Icon: Smartphone,
    accent: 'var(--sp-green)',
    label: 'Schritt 2',
    titel: 'Helfer starten',
    text: 'Adresse im Browser öffnen, per Einmalpasswort anmelden, App aufs Handy legen. Kein App Store.',
  },
  {
    Icon: Euro,
    accent: 'var(--sp-teal)',
    label: 'Schritt 3',
    titel: 'Kassieren',
    text: 'Den ganzen Abend: bestellen, kassieren, stornieren, Küchenbons drucken — pro Tisch.',
  },
  {
    Icon: FileCheck,
    accent: 'var(--sp-violet)',
    label: 'Schritt 4',
    titel: 'Abschluss',
    text: 'Kassensturz mit Differenz, formaler Tagesabschluss (Z-Bon) und DSFinV-K-Export.',
  },
]
---

<section id="ablauf" class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
  <div class="reveal max-w-[660px]">
    <p
      class="inline-flex items-center gap-2.5 text-[0.78rem] font-bold tracking-[0.14em] text-[var(--sp-teal)] uppercase"
    >
      <span
        class="h-[3px] w-[22px] rounded-sm"
        style="background: var(--spectral);"
        aria-hidden="true"></span>
      So funktioniert's
    </p>
    <h2
      class="font-brand mt-3 text-[length:var(--fs-h2)] leading-[1.06] font-bold tracking-[-0.025em]"
    >
      Von der Vorbereitung<br />bis zum Z-Bon.
    </h2>
    <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted">
      Vier Schritte — vom Aufbau am Nachmittag bis zum sauberen Abschluss nach
      dem Fest.
    </p>
  </div>

  <ol
    class="reveal relative mt-11 grid grid-cols-1 gap-8 min-[560px]:grid-cols-2 nav:grid-cols-4 nav:gap-5"
  >
    {/* Spektrale Verbindungslinie hinter den Icons, nur im Vierspalter. */}
    <span
      class="absolute top-[31px] right-[8%] left-[8%] hidden h-[3px] rounded-sm opacity-50 nav:block"
      style="background: var(--spectral);"
      aria-hidden="true"></span>
    {
      schritte.map(({ Icon, accent, label, titel, text }) => (
        <li class="relative">
          <span
            class="flex h-[62px] w-[62px] items-center justify-center rounded-[18px] border border-card-border bg-card shadow-[var(--shadow)]"
            style={{ color: accent }}
          >
            <Icon size={26} />
          </span>
          <p
            class="font-brand mt-[18px] text-[13px] font-bold tracking-[0.04em]"
            style={{ color: accent }}
          >
            {label}
          </p>
          <h3 class="font-brand mt-[5px] text-[19px] font-semibold">{titel}</h3>
          <p class="mt-[7px] text-[14.5px] leading-[1.55] text-muted">{text}</p>
        </li>
      ))
    }
  </ol>
</section>
