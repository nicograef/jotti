---
import { Image } from 'astro:assets'

import '../styles/landing.css'
import jottiSymbol from '../assets/jotti-symbol.png'
import ogImage from '../assets/jotti-bon.webp'
import { githubUrl, leitfadenUrl } from '../lib/links'
import ThemeToggle from '../components/ThemeToggle.tsx'
import MobileNav from '../components/MobileNav.tsx'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImageUrl = new URL(ogImage.src, Astro.site).href

// Header-Navigation (Handoff): Anker-Links plus Leitfaden. Der `#faq`-Link ist
// seit Phase 7 mit seiner Sektion eingehängt. Eine Quelle für Desktop-Nav und
// die MobileNav-Island, damit die Liste nicht auseinanderläuft.
const navLinks = [
  { href: '/#features', label: 'Funktionen' },
  { href: '/#ablauf', label: 'Ablauf' },
  { href: '/#fuerwen', label: 'Für wen' },
  { href: '/#sicherheit', label: 'Sicherheit' },
  { href: '/#faq', label: 'FAQ' },
  { href: leitfadenUrl, label: 'Leitfaden' },
]

// Footer-Spalten (Handoff-Prototyp): Produkt, Ressourcen, Rechtliches. Anker
// zeigen absolut auf die Landing (`/#...`), damit sie auch von den Rechtsseiten
// aus funktionieren. Unter Rechtliches die neuen Seiten plus die erhaltenen
// Links auf Nutzungsbedingungen (TERMS.md) und Lizenz (LICENSE).
const footerSpalten = [
  {
    titel: 'Produkt',
    links: [
      { href: '/#features', label: 'Funktionen', extern: false },
      { href: '/#demo', label: 'Live-Demo', extern: false },
      { href: '/#ablauf', label: 'Ablauf', extern: false },
      { href: '/#preis', label: 'Preis', extern: false },
      { href: '/#faq', label: 'FAQ', extern: false },
    ],
  },
  {
    titel: 'Ressourcen',
    links: [
      { href: leitfadenUrl, label: 'Leitfaden für Vereine', extern: false },
      { href: `${githubUrl}/releases`, label: 'Releases', extern: true },
      { href: githubUrl, label: 'GitHub', extern: true },
    ],
  },
  {
    titel: 'Rechtliches',
    links: [
      { href: '/impressum', label: 'Impressum', extern: false },
      { href: '/datenschutz', label: 'Datenschutz', extern: false },
      {
        href: `${githubUrl}/blob/main/TERMS.md`,
        label: 'Nutzungsbedingungen',
        extern: true,
      },
      { href: `${githubUrl}/blob/main/LICENSE`, label: 'Lizenz', extern: true },
    ],
  },
]
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="author" content="Nico Gräf" />
    <meta name="robots" content="index, follow" />

    <!--
      Theme vor dem ersten Paint setzen: externe, klassisch-synchrone Datei aus
      public/ (kein type=module/defer/async), damit unter der Produktiv-CSP kein
      Inline-Skript nötig ist und kein falsches Theme aufblitzt. Liest denselben
      Starlight-Speicher wie der Doku-Schalter (siehe public/theme-init.js).
    -->
    <script is:inline src="/theme-init.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="jotti" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/jotti-icon-light-32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/jotti-icon-dark-32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/jotti-icon-light-32.png"
    />
    <link rel="apple-touch-icon" href="/icons/jotti-logo-icon-light.png" />
    <meta
      name="theme-color"
      content="#147758"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#121e16"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Schrift vorladen: selbst gehostete Variable-Fonts -->
    <link
      rel="preload"
      href="/fonts/Inter-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only rounded-lg bg-brand-solid px-4 py-2 font-semibold text-white focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:not-sr-only"
      >Zum Inhalt springen</a
    >

    <header
      class="sticky top-0 z-50 border-b border-card-border bg-background/80 backdrop-blur-md"
    >
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-6">
        <a
          href="/"
          class="flex items-center gap-2.5"
          aria-label="jotti Startseite"
        >
          <Image src={jottiSymbol} alt="" class="h-8 w-auto" loading="eager" />
          <span class="font-brand text-[1.375rem] font-bold tracking-tight"
            >jotti</span
          >
        </a>

        <div class="flex-1"></div>

        <nav
          class="hidden items-center gap-7 nav:flex"
          aria-label="Hauptnavigation"
        >
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm font-medium text-muted hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <ThemeToggle client:load />

        <a href="/#download" class="btn btn-sm btn-primary">Für Vereine</a>

        <MobileNav links={navLinks} client:load />
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="border-t border-card-border bg-surface-alt">
      <div class="mx-auto max-w-6xl px-6 pt-16 pb-8">
        <div
          class="grid grid-cols-2 gap-x-8 gap-y-10 nav:grid-cols-[1.6fr_1fr_1fr_1fr]"
        >
          <div class="col-span-2 nav:col-span-1">
            <a
              href="/"
              class="flex items-center gap-2.5"
              aria-label="jotti Startseite"
            >
              <Image
                src={jottiSymbol}
                alt=""
                class="h-7 w-auto"
                loading="lazy"
              />
              <span class="font-brand text-xl font-bold tracking-tight"
                >jotti</span
              >
            </a>
            <p class="mt-4 max-w-[30em] text-[14.5px] leading-relaxed text-muted">
              Das kostenlose Kassensystem für Vereinsfeste. Von einem Entwickler
              für Vereine gebaut.
            </p>
            <div
              class="mt-5 h-1 w-[180px] rounded-sm"
              style="background: var(--spectral);"
              aria-hidden="true">
            </div>
          </div>

          {
            footerSpalten.map((spalte) => (
              <nav aria-label={spalte.titel}>
                <p
                  class="text-[12px] font-bold tracking-[0.1em] text-muted uppercase"
                >
                  {spalte.titel}
                </p>
                <ul class="mt-4 flex flex-col gap-[11px]">
                  {spalte.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.extern ? '_blank' : undefined}
                        rel={link.extern ? 'noopener noreferrer' : undefined}
                        class="text-[14.5px] text-foreground/80 hover:text-brand"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>

        <div
          class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-card-border pt-6 text-[13px] text-muted"
        >
          <span>© 2025–2026 Nico Gräf. Alle Rechte vorbehalten. Source-available.</span>
          <span class="inline-flex items-center gap-2">
            <span
              class="inline-block h-2 w-2 rounded-full"
              style="background: var(--spectral);"
              aria-hidden="true"></span>
            Gebaut in Deutschland
          </span>
        </div>
      </div>
    </footer>

  </body>
</html>
