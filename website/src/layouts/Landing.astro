---
import { Image } from 'astro:assets'

import '../styles/landing.css'
import jottiSymbol from '../assets/jotti-symbol.png'
import ogImage from '../assets/jotti-bon.webp'
import { githubUrl, leitfadenUrl } from '../lib/links'
import ThemeToggle from '../components/ThemeToggle.tsx'
import MobileNav from '../components/MobileNav.tsx'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImageUrl = new URL(ogImage.src, Astro.site).href

// Header-Navigation (Handoff): Anker-Links plus Leitfaden. Der `#faq`-Link folgt
// erst in Phase 7 mit seiner Sektion. Eine Quelle für Desktop-Nav und die
// MobileNav-Island, damit die Liste nicht auseinanderläuft.
const navLinks = [
  { href: '/#features', label: 'Funktionen' },
  { href: '/#ablauf', label: 'Ablauf' },
  { href: '/#fuerwen', label: 'Für wen' },
  { href: '/#sicherheit', label: 'Sicherheit' },
  { href: leitfadenUrl, label: 'Leitfaden' },
]
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="author" content="Nico Gräf" />
    <meta name="robots" content="index, follow" />

    <!--
      Theme vor dem ersten Paint setzen: externe, klassisch-synchrone Datei aus
      public/ (kein type=module/defer/async), damit unter der Produktiv-CSP kein
      Inline-Skript nötig ist und kein falsches Theme aufblitzt. Liest denselben
      Starlight-Speicher wie der Doku-Schalter (siehe public/theme-init.js).
    -->
    <script is:inline src="/theme-init.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="jotti" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/jotti-icon-light-32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/jotti-icon-dark-32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/jotti-icon-light-32.png"
    />
    <link rel="apple-touch-icon" href="/icons/jotti-logo-icon-light.png" />
    <meta
      name="theme-color"
      content="#147758"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#121e16"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Schrift vorladen: selbst gehostete Variable-Fonts -->
    <link
      rel="preload"
      href="/fonts/Inter-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only rounded-lg bg-brand-solid px-4 py-2 font-semibold text-white focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:not-sr-only"
      >Zum Inhalt springen</a
    >

    <header
      class="sticky top-0 z-50 border-b border-card-border bg-background/80 backdrop-blur-md"
    >
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-6">
        <a
          href="/"
          class="flex items-center gap-2.5"
          aria-label="jotti Startseite"
        >
          <Image src={jottiSymbol} alt="" class="h-8 w-auto" loading="eager" />
          <span class="font-brand text-[1.375rem] font-bold tracking-tight"
            >jotti</span
          >
        </a>

        <div class="flex-1"></div>

        <nav
          class="hidden items-center gap-7 nav:flex"
          aria-label="Hauptnavigation"
        >
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm font-medium text-muted hover:text-foreground"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <ThemeToggle client:load />

        <a href="/#download" class="btn btn-sm btn-primary">Für Vereine</a>

        <MobileNav links={navLinks} client:load />
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="spectrum-edge-t py-10">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-6 text-center"
      >
        <a
          href="/"
          class="flex items-center gap-2"
          aria-label="jotti Startseite"
        >
          <Image src={jottiSymbol} alt="" class="h-7 w-auto" loading="lazy" />
          <span class="font-brand text-xl font-bold tracking-tight">jotti</span>
        </a>
        <p class="max-w-160 text-[0.9375rem] text-muted">
          Das kostenlose Kassensystem mit TSE-Anbindung für Vereinsfeste und
          gemeinnützige Organisationen.
        </p>
        <nav
          class="flex flex-wrap justify-center gap-6"
          aria-label="Footer-Navigation"
        >
          <a
            href={leitfadenUrl}
            class="text-sm font-semibold text-muted hover:text-brand"
            >Leitfaden für Vereine</a
          >
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-muted hover:text-brand">GitHub</a
          >
          <a
            href={`${githubUrl}/blob/main/TERMS.md`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-muted hover:text-brand"
            >Nutzungsbedingungen</a
          >
          <a
            href={`${githubUrl}/blob/main/LICENSE`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-muted hover:text-brand">Lizenz</a
          >
        </nav>
        <p
          class="w-full border-t border-card-border pt-5 text-[0.8125rem] text-muted"
        >
          Entwickelt von
          <a
            href="https://nicograef.de"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold hover:text-brand">Nico Gräf</a
          >
        </p>
      </div>
    </footer>

  </body>
</html>
