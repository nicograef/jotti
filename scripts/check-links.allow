# scripts/check-links.sh allowlist — "path  line-fragment  # reason", one exempt line pattern per entry.
docs/leitfaden/datenaufbewahrung.md  KURZANLEITUNG.md  # names the file shipped in the Windows ZIP, see packaging/windows/KURZANLEITUNG.md
docs/leitfaden/installation.md  KURZANLEITUNG.md  # names the file shipped in the Windows ZIP, see packaging/windows/KURZANLEITUNG.md
website/src/lib/published-docs.ts  .md',  # list entries are relative to docs/
website/src/lib/link-rewriter.ts  [x.md](x.md)  # example link syntax in a comment
website/src/lib/link-rewriter.ts  Link-Ziel  # doc comment example of a link target
website/src/lib/link-rewriter.ts  Quelldokuments  # doc comment example of a docs/-relative source path
website/src/lib/link-rewriter.ts  normalisiert  # comment example of a path leaving docs/
website/src/lib/link-rewriter.test.ts  rewrite('  # fixture targets relative to docs/
website/src/lib/link-rewriter.test.ts  target:  # fixture targets relative to the fixture's source path
website/src/lib/link-rewriter.test.ts  sourcePath  # fixture source paths relative to docs/
website/src/lib/link-rewriter.test.ts  publishedDocs:  # fixture list relative to docs/
