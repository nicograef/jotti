# scripts/check-prose.sh allowlist — one path per line, reason after "#".
frontend/src/lib/utils.test.ts  # 'ergänzt an früheren Tagen das Datum' ist Fachprosa zur Datumsberechnung, kein Historienbezug
scripts/check-prose.sh  # zitiert die verbotenen Wörter selbst (Pattern und Kommentare), wie AGENTS.md Regel 18
scripts/check-prose.allow  # diese Datei selbst: Begründungstexte zitieren die erlaubten Fundstellen wörtlich
docs/steuerrecht.md  # 'die frühere Vereinfachung (einheitlich 19 %) entfällt' beschreibt eine reale UStG-Änderung zum 1.1.2026, kein Projekt-Historienbezug
windows/starter/system.go  # 'ein veralteter Marker aus einem frueheren Boot' beschreibt einen Laufzeit-Zustand des Containers, kein Historienbezug
