# Zugangsdaten für die TSE-Live-Tests gegen die fiskaly-TEST-Umgebung
# (make test-tse-live / make test-tse-live-setup). Als .env.fiskaly-test
# kopieren und füllen; die Kopie ist gitignored und bleibt lokal.
#
# API-Key/-Secret: test.hub.fiskaly.com > API-Schlüssel. Das Secret zeigt
# fiskaly nur einmal bei der Erstellung an.
FISKALY_TEST_API_KEY=
FISKALY_TEST_API_SECRET=
FISKALY_TEST_TSS_ID=
FISKALY_TEST_CLIENT_ID=

# Nur für Admin-Operationen an der TEST-TSS (z. B. PIN neu setzen), wird
# von den Tests nicht gelesen. Der PUK ist nach der Personalisierung der
# TSS nicht mehr abrufbar, die PIN nie — beide nur hier.
FISKALY_TEST_ADMIN_PUK=
FISKALY_TEST_ADMIN_PIN=
