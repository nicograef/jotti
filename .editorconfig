root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go – gofmt enforces tabs
[*.go]
indent_style = tab

# Caddyfile – caddy fmt uses tabs
[Caddyfile*]
indent_style = tab

# Makefile – tabs required by make
[Makefile]
indent_style = tab

# Markdown – trailing spaces can be intentional (line breaks)
[*.md]
trim_trailing_whitespace = false

# Windows batch – CRLF, matching .gitattributes
[*.cmd]
end_of_line = crlf
